# =============================================================================
# Dayflow Backend — Example Environment
# =============================================================================
# Copy this file to `.env` and fill real values (`.env` is gitignored).
# Supabase project ref example: axhiwzngefjkerrmimyk
# =============================================================================

# --- Supabase Postgres (pooler, SQLAlchemy asyncpg) ---
# Get from: Supabase Dashboard → Database → Connection string → URI (pooled 5432)
# Keep `postgresql+asyncpg://` prefix for asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres.<project_ref>:<db_password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Supabase Project (Storage + Helpers) ---
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<project_ref>.supabase.co
# Public anon key → also set as VITE_SUPABASE_ANON_KEY in frontend/.env
SUPABASE_ANON_KEY=<anon-jwt-from-supabase-api-settings>
# Secret service_role → backend only for storage bucket uploads (never expose to frontend)
SUPABASE_SERVICE_KEY=<service_role-jwt-from-supabase-api-settings>

# --- JWT Auth (FastAPI python-jose) ---
# Generate: openssl rand -hex 32  (32+ chars)
SECRET_KEY=change-this-to-a-random-32-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated CORS origins (must be lowercase, exact match incl. scheme; no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://<project_ref>.supabase.co,https://dayflow.susindran.in
# Base URL of the frontend — used in verification / invite email links (no trailing slash)
FRONTEND_URL=https://dayflow.susindran.in

# --- SMTP Email (Brevo Relay) ---
# Get from: Brevo Dashboard → Transactional → SMTP & Senders & Domains
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<brevo-smtp-login-e.g.-a2301b001@smtp-brevo.com>
# Brevo SMTP key placeholder (regenerate if 535 auth fails)
SMTP_PASSWORD=<brevo-smtp-key-placeholder>
# Must be verified sender domain in Brevo (SPF/DKIM)
SMTP_FROM_EMAIL=noreply@Dayflow.susindran.in
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Feature Flags ---
# true = login 403 until email verified via /auth/verify-email; false = soft banner only
REQUIRE_EMAIL_VERIFICATION=false
